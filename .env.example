# Keitaro: адрес стенда (без /admin_api/v1) и ключ из кнопки «API ключ» в админке
KT_BASE_URL=https://keitaro-for-tests.etolegko.com
KT_API_KEY=

# Локальная БД обёртки (SQLite по умолчанию; для Postgres: postgresql+psycopg2://user:pass@host/db)
DATABASE_URL=sqlite:///./adrobot.db

# Префикс названий кампаний по правилам стенда: test_фамилия_...
CANDIDATE_PREFIX=karelov

# Куда редиректит первый поток и корень админки стенда
GOOGLE_URL=https://google.com
KT_ADMIN_URL=https://keitaro-for-tests.etolegko.com/admin/
